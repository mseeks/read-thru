flowchart LR
    %% Three parallel discriminated unions kept in lock-step by the state machine.
    subgraph S["🧊 BumpState (where we are)"]
      direction TB
      s1["Discovered"] --> s2["Judged"] --> s3["AwaitingCi"] --> s4["Recorded ∎"]
    end
    subgraph EV["📨 LoopEvent (what just happened)"]
      direction TB
      e1["ChangelogJudged"]
      e2["PullRequestReady"]
      e3["CiResolved"]
      e4["OutcomeRecorded"]
    end
    subgraph EF["⚡ Effect (what to do next)"]
      direction TB
      f1["JudgeChangelog"]
      f2["OpenPullRequest"]
      f3["AwaitCi"]
      f4["RecordOutcome"]
    end
    s1 -. emits .-> f1
    f1 -. yields .-> e1
    e1 ==> s2
    s2 -. emits .-> f2
    f2 -. yields .-> e2
    e2 ==> s3
    s3 -. emits .-> f3
    f3 -. yields .-> e3
    e3 ==> s4

