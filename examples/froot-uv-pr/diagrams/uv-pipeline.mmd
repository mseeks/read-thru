classDef port fill:#fdf3e7,stroke:#cc7a30,stroke-width:2px,color:#8a4b12;
classDef ext fill:#eceff1,stroke:#78909c,stroke-width:2px,color:#37474f;
classDef drop fill:#fdeaea,stroke:#c0392b,stroke-width:2px,color:#7b241c;
